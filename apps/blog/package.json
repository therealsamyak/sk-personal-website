{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && astro build",
    "cf-build": "cf build",
    "dev": "portless",
    "dev:app": "astro dev --port ${PORT:-4321}",
    "cf-deploy": "pnpm run build && pnpm run db:migrate && cf deploy --prebuilt && pnpm run db:check",
    "db:status": "emdash migrate --status --account-id \"$CLOUDFLARE_ACCOUNT_ID\" --d1 \"$D1_DATABASE_ID\"",
    "db:migrate": "emdash migrate --account-id \"$CLOUDFLARE_ACCOUNT_ID\" --d1 \"$D1_DATABASE_ID\" --expected-target-fingerprint \"$EMDASH_TARGET_FINGERPRINT\"",
    "db:check": "emdash migrate --check --account-id \"$CLOUDFLARE_ACCOUNT_ID\" --d1 \"$D1_DATABASE_ID\"",
    "preview": "astro preview",
    "typegen": "emdash types --url https://blog.skakatur.dev",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.5",
    "@astrojs/react": "^7.1.8",
    "@emdash-cms/cloudflare": "1.5.0",
    "@emdash-cms/plugin-forms": "^0.2.13",
    "astro": "^7.4.11",
    "emdash": "1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261113.1",
    "cf": "1.0.0-beta.31",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  },
  "portless": {
    "name": "blog",
    "script": "dev:app"
  }
}
