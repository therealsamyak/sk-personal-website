{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro check && astro build",
    "cf-build": "astro build",
    "dev": "portless",
    "dev:app": "astro dev --port ${PORT:-4321}",
    "dev-r": "wrangler dev --remote",
    "cf-deploy": "wrangler deploy",
    "preview": "astro preview",
    "typegen": "emdash types --url https://blog.skakatur.dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "@emdash-cms/cloudflare": "1.3.0",
    "@emdash-cms/plugin-forms": "^0.2.10",
    "@policystack/core": "^1.5.0",
    "@policystack/sdk": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "emdash": "1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@policystack/vite": "^1.5.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  },
  "portless": {
    "name": "blog",
    "script": "dev:app"
  }
}
