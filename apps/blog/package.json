{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro check && astro build",
    "cf-build": "astro build",
    "dev": "portless",
    "dev:app": "wrangler dev --port ${PORT:-8787}",
    "dev-r": "wrangler dev --remote",
    "cf-deploy": "wrangler deploy",
    "preview": "astro preview",
    "typegen": "emdash types --url https://blog.skakatur.dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.0",
    "@astrojs/react": "^5.0.6",
    "@emdash-cms/cloudflare": "0.15.0",
    "@emdash-cms/plugin-forms": "^0.2.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "emdash": "0.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260528.1",
    "wrangler": "^4.95.0"
  },
  "portless": {
    "name": "blog",
    "script": "dev:app"
  }
}
