---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);

// Group posts by publish year, newest first. Unpublished previews use their creation date.
const postDate = (post: (typeof posts)[number]) => post.data.publishedAt ?? post.data.createdAt;
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = postDate(post).getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}

const shortDate = (date: Date) =>
	date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
---

<Base title="Writing">
	{posts.length === 0 && <p class="blog-empty">No posts yet.</p>}
	{
		[...years].map(([year, yearPosts]) => (
			<section class="blog-year">
				<h2>{year}</h2>
				<ul class="blog-titles">
					{yearPosts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`}>{post.data.title}</a>
							<time datetime={postDate(post).toISOString()}>{shortDate(postDate(post))}</time>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Base>
