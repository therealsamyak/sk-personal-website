---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getEntryTerms, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import { CommentForm, Comments } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import { getReadingStats } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

// Get featured image URL for the Open Graph image
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}

// Newer and older neighbors come from two one-row range queries, not the full post list.
const publishedAt = post.data.publishedAt?.toISOString();
const neighborQuery = (direction: "newer" | "older") =>
	publishedAt
		? getEmDashCollection("posts", {
				where: { published_at: direction === "newer" ? { gt: publishedAt } : { lt: publishedAt } },
				orderBy: { published_at: direction === "newer" ? "asc" : "desc" },
				limit: 1,
			})
		: null;

// post.data.id is the database ULID; post.id is the slug.
const [siteSettings, categories, newerResult, olderResult] = await Promise.all([
	getSiteSettings(),
	getEntryTerms("posts", post.data.id, "category"),
	neighborQuery("newer"),
	neighborQuery("older"),
]);
const newer = newerResult?.entries[0];
const older = olderResult?.entries[0];

Astro.cache.set({
	...cacheHint,
	tags: [
		...(cacheHint.tags ?? []),
		...(newerResult?.cacheHint.tags ?? []),
		...(olderResult?.cacheHint.tags ?? []),
	],
});

const { siteTitle } = resolveBlogSiteIdentity(siteSettings);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage: getImageUrl(post.data.featured_image),
});

const category = categories[0];
const { readingTime } = getReadingStats(post.data.content);
const postDate = post.data.publishedAt ?? post.data.createdAt;
const longDate = postDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article>
		<h1 class="blog-post-title" {...post.edit.title}>{post.data.title}</h1>
		<p class="blog-post-meta">
			<time datetime={postDate.toISOString()}>{longDate}</time> · {readingTime} min read{category && ` · ${category.label}`}
		</p>
		<div class="blog-body">
			<PortableText value={post.data.content} />
		</div>
	</article>

	{
		(newer || older) && (
			<nav class="blog-pager" aria-label="More posts">
				<div>
					{newer && (
						<a href={`/posts/${newer.id}`}>
							<small>Newer</small>
							{newer.data.title}
						</a>
					)}
				</div>
				<div class="blog-pager-older">
					{older && (
						<a href={`/posts/${older.id}`}>
							<small>Older</small>
							{older.data.title}
						</a>
					)}
				</div>
			</nav>
		)
	}

	<section class="blog-comments">
		<Comments collection="posts" contentId={post.data.id} threaded />
		<CommentForm collection="posts" contentId={post.data.id} />
	</section>
</Base>
