---
// Mounts no markup. Its client script follows the shared PolicyStack store.
---

<script>
 import { sharedConsentStore } from "../lib/consent-store"
 import { umamiAnalyticsConfig } from "../lib/umami-analytics"

 type UmamiTracker = {
   track: (trackEvent?: (properties: Record<string, unknown>) => Record<string, unknown>) => Promise<void>
 }

 declare global {
   interface Window {
     umami?: UmamiTracker
   }
 }

 const UMAMI_SCRIPT_SELECTOR = "script[data-umami-consent-gated='true']"
 let routeTrackingInstalled = false

 function trackCurrentUmamiPageView() {
   try {
   void window.umami?.track((properties) => ({ ...properties, url: location.href }))
   } catch {
     // Umami failures must not affect navigation or the blog.
   }
 }

 function installUmamiRouteTracking() {
   if (routeTrackingInstalled) return
   routeTrackingInstalled = true
   window.addEventListener("popstate", trackCurrentUmamiPageView)
 }

 function syncUmamiScript(state: ReturnType<typeof sharedConsentStore.getState>) {
   if (!umamiAnalyticsConfig || state.decisions.analytics !== true) {
     document.querySelectorAll(UMAMI_SCRIPT_SELECTOR).forEach((script) => script.remove())
     delete window.umami
     return
   }

   installUmamiRouteTracking()
   if (document.querySelector(UMAMI_SCRIPT_SELECTOR)) return

   const script = document.createElement("script")

   script.src = umamiAnalyticsConfig.scriptUrl
   script.async = true
   script.dataset.umamiConsentGated = "true"
   script.dataset.websiteId = umamiAnalyticsConfig.websiteId
   script.dataset.autoTrack = "false"
   script.dataset.doNotTrack = "true"

   script.addEventListener(
     "load",
   () => {
		 if (script.isConnected) trackCurrentUmamiPageView()
   },
   { once: true },
  )

   script.addEventListener(
     "error",
   () => {
     script.remove()
     delete window.umami
   },
   { once: true },
  )

   document.head.append(script)
 }

 const unsubscribeInitial = sharedConsentStore.subscribe(syncUmamiScript)
 syncUmamiScript(sharedConsentStore.getState())
 window.addEventListener("pagehide", unsubscribeInitial)
</script>
