---
// Track every public blog page, including client-router navigations, through the shared layout.
---

<script>
  import { loadUmamiAnalytics, trackUmamiPageView } from "../lib/umami-browser"
  import { umamiAnalyticsConfig } from "../lib/umami-analytics"

  if (umamiAnalyticsConfig) {
    loadUmamiAnalytics({ ...umamiAnalyticsConfig, manualPageviews: true })
    document.addEventListener("astro:page-load", trackUmamiPageView)
  }
</script>
