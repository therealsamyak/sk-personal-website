{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/ui/*": ["./components/ui/*"],
      "@/config/*": ["./config/*"]
    },
    "types": ["vinext/types", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.tsx", ".cloudflare/types/**/*.d.ts"],
  "exclude": ["node_modules", "opensrc"]
}
