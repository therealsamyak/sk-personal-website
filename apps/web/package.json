{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "portless",
    "dev:app": "next dev",
    "start": "next start",
    "preview": "pnpm run cf-build && pnpm run cf-preview",
    "deploy": "pnpm run cf-build && pnpm run cf-deploy",
    "cf-typegen": "cf workers types",
    "cf-build": "opennextjs-cloudflare build --skipWranglerConfigCheck && wrangler build --experimental-new-config --experimental-cf-build-output",
    "cf-preview": "wrangler dev --experimental-new-config",
    "cf-deploy": "cf deploy --prebuilt"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cf": "1.0.0-beta.27",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  },
  "portless": {
    "name": "web",
    "script": "dev:app"
  }
}
