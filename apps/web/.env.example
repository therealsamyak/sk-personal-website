# Next.js Configuration
NEXT_PUBLIC_BASE_URL=https://test.dev

# Self-hosted Umami analytics. Production requires both values.
# Base URL shape: https://analytics.example.com (no path, query, or fragment)
# Website ID shape: 00000000-0000-4000-8000-000000000000
# Empty values disable analytics quietly for local development.
NEXT_PUBLIC_UMAMI_BASE_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Resend API Configuration
RESEND_API_KEY=your_resend_api_key_here

# Email Configuration
NOTIFICATION_EMAIL=your-email@test.dev
FROM_EMAIL=your-from-email@test.dev

# Cloudflare Turnstile Configuration
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
